{
  "name": "bubbly-backend",
  "version": "1.0.0",
  "description": "School Management SaaS - API",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "db:create": "node database/create.js",
    "migration": "sequelize-cli db:migrate",
    "migration:undo": "sequelize-cli db:migrate:undo",
    "migration:status": "sequelize-cli db:migrate:status",
    "seeder": "sequelize-cli db:seed:all",
    "seeder:undo": "sequelize-cli db:seed:undo:all",
    "seed:demo": "node database/demo.js",
    "seed:test-school": "node database/seed-test-school.js",
    "setup": "npm run db:create && npm run migration && npm run seeder"
  },
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "axios": "1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.3",
    "module-alias": "^2.3.4",
    "multer": "2.5.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "_moduleAliases": {
    "@app": "app",
    "@config": "config",
    "@routes": "routes",
    "@database": "database"
  }
}
