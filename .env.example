NODE_ENV=development
APP_NAME=Bubbly
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bubbly
DB_USER=postgres
DB_PASSWORD=

# Login tokens. Use a long random value (at least 32 characters), different on every server.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
# Login attempts allowed per minute per IP (default 10)
ADMIN_LOGIN_RATE_MAX=10
# Same for school users (Principal, Teacher, Student)
USER_LOGIN_RATE_MAX=10

# Which apps may call this API (comma separated) and where the Admin app lives (used in reset-password links)
CORS_ORIGINS=http://localhost:5005
ADMIN_APP_URL=http://localhost:5005
# The web app (public site and school workspace). Used in welcome and reset-password links sent to school users.
# Add its address to CORS_ORIGINS too, for example CORS_ORIGINS=http://localhost:5005,http://localhost:3001
WEB_APP_URL=http://localhost:3001

# First accounts created by the seeder. They must change the password at first login.
SEED_MASTER_NAME=Master Admin
SEED_MASTER_EMAIL=
SEED_MASTER_PASSWORD=
SEED_SUBADMIN_NAME=Sub Admin
SEED_SUBADMIN_EMAIL=
SEED_SUBADMIN_PASSWORD=

# Where uploaded files are kept: local (this server's disk). The signing secret protects links of private files
# (leave empty to reuse JWT_ACCESS_SECRET). API_PUBLIC_URL is the address of this API, used to build file links.
STORAGE_DRIVER=local
FILES_SIGNING_SECRET=
API_PUBLIC_URL=http://localhost:3000

# Email through Loops (optional while developing: without a key the message is printed in the terminal)
LOOPS_API_KEY=
LOOPS_TX_PASSWORD_RESET=

# Razorpay (test keys while developing). The webhook secret is a long random value you choose and also enter in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
